{
  "name": "evotm/evosc",
  "type": "project",
  "description": "EvoSC is a modern server controller for the game Trackmania² and TM2020.",
  "keywords": [
    "Evo",
    "Maniaplanet",
    "Trackmania"
  ],
  "license": "Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International Public License",
  "homepage": "https://github.com/EvoEsports/EvoSC",
  "require": {
    "php": "^8.5",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-simplexml": "*",
    "ext-mbstring": "*",
    "ext-zip": "*",
    "symfony/console": "^6.4 || ^7.2",
    "guzzlehttp/guzzle": "^7.9",
    "latte/latte": "^3.0",
    "symfony/process": "^6.4 || ^7.2",
    "symfony/event-dispatcher": "^6.4 || ^7.2",
    "symfony/var-dumper": "^6.4 || ^7.2",
    "composer/ca-bundle": "^1.5",
    "illuminate/container": "^10.0 || ^11.0",
    "illuminate/database": "^10.0 || ^11.0",
    "mexitek/phpcolors": "^1.0",
    "league/csv": "^9.16",
    "doctrine/dbal": "^3.9"
  },
  "replace": {
    "manialib/gbx": "4.1.1",
    "maniaplanet/dedicated-server-api": "5.0.0"
  },
  "scripts": {
    "pre-install-cmd": [
      "php core/required_directories.php"
    ]
  },
  "autoload": {
    "psr-4": {
      "EvoSC\\": "core/",
      "EvoSC\\Modules\\": [
        "core/Modules/",
        "modules/"
      ],
      "Manialib\\Gbx\\": "core/Packages/Manialib/Gbx/",
      "Maniaplanet\\DedicatedServer\\": "core/Packages/Maniaplanet/DedicatedServer/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5"
  },
  "config": {
    "platform": {
      "php": "8.5.12"
    }
  }
}
